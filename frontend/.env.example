# Copy to .env.local and edit if your backend is not on the default address.
#
# Vite only exposes variables that start with VITE_, and it substitutes them at
# BUILD time — changing this after a deploy does nothing until you rebuild.
#
# Local development: leave this file alone. api.js already falls back to the
# address below when the variable is unset.
#
# Vercel: set VITE_API_URL in Project Settings > Environment Variables to the
# Render URL, with no trailing slash — https://expense-tracker-api.onrender.com
VITE_API_URL=http://127.0.0.1:8000
